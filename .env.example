# Copie para .env e preencha os valores do seu ambiente.
DATABASE_URI=file:./payload.db
# Substitua por um segredo aleatorio forte e exclusivo do ambiente.
PAYLOAD_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Autenticacao real no servico externo.
LDAP_AUTH_MODE=external
# URL base, sem /auth/ldap/autenticar ou /auth/ldap/buscar-por-login.
LDAP_API_URL=https://ldap.example.test

# Para testar sem API, use tambem .env.development.local.example.
# O arquivo .env.development.local tem precedencia sobre .env no next dev.
# Nao defina NODE_ENV aqui: o Next.js seleciona o ambiente pelo comando.
