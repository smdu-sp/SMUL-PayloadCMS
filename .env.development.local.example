# Copie para .env.development.local; mantenha a configuracao base em .env.
# Carregado apenas em desenvolvimento. Nao e carregado pelo next build/start.
LDAP_AUTH_MODE=mock
LDAP_DEV_LOGIN=dev.admin
# Senha ficticia para uso local; altere conforme necessario.
LDAP_DEV_PASSWORD=admin123

# O seed cadastra dev.admin@example.test com role admin.
# No PowerShell, antes de executar o seed:
# $env:NODE_ENV = 'development'
# npm.cmd run seed:dev-admin
# npm.cmd run dev

# Para voltar a API externa no next dev, troque mock por external acima
# ou remova .env.development.local, encerre a sessao e reinicie o servidor.
